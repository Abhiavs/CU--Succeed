# ============================================================
# CU Succeed — Environment Variables
#
# Copy this file to `.env` for LOCAL development:
#     cp .env.example .env
#
# For the HOSTED (production) copy on Railway/Render/Fly, do NOT
# use this file — set the SAME variable names in the platform's
# dashboard so each environment (dev DB vs prod DB) keeps its own
# values. See DEPLOYMENT.md.
# ============================================================

# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------
# LOCAL DEVELOPMENT — point at your local PostgreSQL.
DATABASE_URL="postgresql://cu_succeed:change-me@127.0.0.1:5432/cu_succeed?schema=public"

# PRODUCTION (host) — set this on Railway/Render/Fly to the hosted
# PostgreSQL connection string the platform gives you. The code is
# identical; only this variable changes:
#   DATABASE_URL="postgresql://user:pass@<host-url>:5432/<db>?schema=public"

# ------------------------------------------------------------
# NEXT-AUTH
# ------------------------------------------------------------
# Session signing secret. MUST be unique per environment.
# Generate one with:  openssl rand -base64 32
# LOCAL DEVELOPMENT (any random string is fine)
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# PRODUCTION (host) — generate a SEPARATE secret from the dev one
# and set it in the host dashboard.

# Canonical URL of this deployment. NextAuth uses it to build
# callbacks/redirects, so it must match where the app actually runs.
# LOCAL DEVELOPMENT:
NEXTAUTH_URL="http://localhost:3000"

# PRODUCTION (host) — e.g.:
#   NEXTAUTH_URL="https://<your-app>.up.railway.app"
#   NEXTAUTH_URL="https://<your-app>.onrender.com"
#   NEXTAUTH_URL="https://<your-app>.fly.dev"

# ------------------------------------------------------------
# FUTURE (not used yet) — email OTP / magic-link auth
# ------------------------------------------------------------
# RESEND_API_KEY="re_..."
# EMAIL_FROM="CU Succeed <noreply@your-domain.com>"
