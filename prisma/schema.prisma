generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String  @id @default(cuid())
  name           String
  email          String  @unique
  password       String
  role           String  @default("STUDENT")
  rollNumber     String?
  branch         String?
  year           String?
  assessmentType String?
  collegeName    String?
  batch          String?

  attempts     Attempt[]
  certificates Certificate[]
  wheelScores  WheelScore[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Program {
  id          String  @id
  name        String
  description String?
  postAssessmentPublished Boolean @default(false)

  assessments  Assessment[]
  certificates Certificate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Question {
  id            String  @id @default(cuid())
  text          String
  type          String
  parameter     String?
  correctAnswer String?
  options       Json

  assessments    AssessmentQuestion[]
  attemptAnswers AttemptAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Assessment {
  id          String  @id @default(cuid())
  title       String
  description String?
  type        String
  isActive    Boolean @default(true)

  programId String
  program   Program @relation(fields: [programId], references: [id])

  questions AssessmentQuestion[]
  attempts  Attempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AssessmentQuestion {
  id String @id @default(cuid())

  assessmentId String
  questionId   String

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, questionId])
}

model Attempt {
  id String @id @default(cuid())

  studentId    String
  assessmentId String?

  status   String    @default("IN_PROGRESS")
  score    Int?
  category String?
  endTime  DateTime?

  reattemptAllowed Boolean @default(false)

  student    User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assessment Assessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  answers      AttemptAnswer[]
  certificates Certificate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AttemptAnswer {
  id String @id @default(cuid())

  attemptId  String
  questionId String

  selectedAnswer String?
  isCorrect      Boolean?

  attempt  Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

model Certificate {
  id String @id @default(cuid())

  studentId          String
  programId          String
  assessmentResultId String

  student          User    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  program          Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  assessmentResult Attempt @relation(fields: [assessmentResultId], references: [id], onDelete: Cascade)

  status String @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WheelScore {
  id String @id @default(cuid())

  studentId String
  type      String

  dimensions Json

  totalScore   Float
  averageScore Float

  year String?

  reattemptAllowed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model WheelDimension {
  id String @id @default(cuid())

  name String

  assessmentType String

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
